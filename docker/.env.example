# Chain selection: "bitcoin" or "litecoin"
CHAIN=litecoin

# Path to the blockchain node's data directory
# Bitcoin:  CHAIN_DATA_DIR=/path/to/bitcoin
# Litecoin (macOS): CHAIN_DATA_DIR=/Users/you/Library/Application Support/Litecoin
CHAIN_DATA_DIR=/path/to/litecoin

# RPC connection settings (use host.docker.internal when litecoind runs on the Mac host)
RPC_HOST=host.docker.internal
RPC_USER=litecoin
RPC_PASSWORD=litecoin

# BRK index + computed data (bind-mount preserves index across container rebuilds)
BRK_DATA_DIR=/Users/you/.brk
